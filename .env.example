# ===== بوت تليجرام =====
# التوكن من @BotFather
BOT_TOKEN=
# كلمة سر للـ Webhook: حروف إنجليزي وأرقام بس، 32 حرف أو أكتر
WEBHOOK_SECRET=
# عنوان اللوحة
PUBLIC_URL=https://team.vitalmedx.app

# ===== الأمان =====
# نص عشوائي طويل (64 حرف). اعمله بـ: openssl rand -hex 32
SESSION_SECRET=

# ===== حساب الأدمن (بيتعمل أول مرة بس مع npm run seed) =====
ADMIN_EMAIL=admin@vitalmedx.app
ADMIN_PASSWORD=

# ===== رسايل الإدارة =====
# Chat ID بتاع الأدمن (التقرير اليومي بيوصله)
ADMIN_CHAT_ID=
# Chat ID بتاع القناة الخاصة اللي بيتبعتلها الباك أب (بيبدأ بـ -100)
BACKUP_CHAT_ID=

TZ_NAME=Africa/Cairo
